{
  "Bybit": {
    "Environment": "DemoTrading",

    "ApiKey": "",
    "ApiSecret": "",

    "Leverage": 1,
    "TickPoolMs": 300
  },

  "Bot": {
    "Symbol": "BTCUSDT",
    "AutoStart": false,
    "RequireFlatOnStart": true,
    "CancelOrphanOrdersOnStart": true,
    "EventLogSize": 300,

    "Grid": {
      "Direction": "Long",

      "EntryVolume": 0.001,
      "LevelVolume": 0.001,
      "Levels": 10,

      "StepPercent": 0.3,
      "StepTicks": 0,
      "FixedStepInTicks": false,

      "VolumeFactor": 1.0,
      "PriceFactor": 1.0,

      "TakeProfitPercent": 1.5,
      "TakeProfitBase": "Dynamic",
      "AlignTakeProfitToGrid": false,

      "StopLossPercent": 5.0,
      "StopLossBase": "Dynamic",

      "TrailingStopPercent": 0,

      "MaxOpenOrders": 5,
      "MaxPositionVolume": 0.01,

      "RestartAfterTakeProfit": true,
      "RestartAfterStopLoss": false
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CryptoExchange.Net": "Warning",
      "Bybit.Net": "Warning"
    }
  },

  "AllowedHosts": "*"
}
