<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Только nuget.org: сборка не должна зависеть от того, какие ленты прописаны на машине
    разработчика. Без этого на машинах с корпоративными лентами restore молча ходит ещё
    и туда, а в CI сборка идёт по другому набору источников, чем локально.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
